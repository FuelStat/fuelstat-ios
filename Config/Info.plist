<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys that have no INFOPLIST_KEY_ build setting. Xcode merges this file with the generated Info.plist
  (GENERATE_INFOPLIST_FILE = YES), so everything else stays in the build settings.
-->
<plist version="1.0">
<dict>
	<!-- Other ways people say the app name, so Siri recognises "Fuel Stat" or "FuelStat" in App Shortcut phrases. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>FuelStat</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Fuel Stat</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fuel Stat</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Fuel Stat</string>
		</dict>
	</array>
</dict>
</plist>

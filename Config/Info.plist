<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys that have no INFOPLIST_KEY_ build setting. Xcode merges this file with the generated Info.plist
  (GENERATE_INFOPLIST_FILE = YES), so everything else stays in the build settings.
-->
<plist version="1.0">
<dict>
	<!-- Keychain group shared with the widgets (see Shared/KeychainStore.swift). -->
	<key>FuelstatKeychainGroup</key>
	<string>$(AppIdentifierPrefix)org.fuelstat.shared</string>
	<!-- Links from the widgets: fuelstat://add, fuelstat://vehicle/<id> (FuelstatCore.AppLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.fuelstat.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fuelstat</string>
			</array>
		</dict>
	</array>
	<!-- Other ways people say the app name, so Siri recognises "Fuel Stat" or "FuelStat" in App Shortcut phrases. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>FuelStat</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Fuel Stat</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Fuel Stat</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Fuel Stat</string>
		</dict>
	</array>
</dict>
</plist>
